# easy-vllm-memwatch.service — mem_watchdog 상시(광역) 인스턴스 (plan_26071019 §2.2 계층 방어 1층).
# 설치 = scripts/install_host_safety.sh (HITL sudo). ExecStart 는 /usr/local/sbin 설치본을 가리킴
# (레포 경로 비의존 — 포인터 원칙: 갱신은 installer 재실행).
# 하네스 협역 인스턴스(run_trial.py·multinode_serve_smoke.sh)와 병행 — 임계 동급이나 필터가 넓어
# 상시층이 최후 커버리지를 보장(δ2-1 "미기동 상황이 유일한 실패 원인" 교훈).
[Unit]
Description=easy-vllm mem watchdog (GB10 unified-memory host hard-down guard)
After=docker.service
Wants=docker.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/easy-vllm-memwatch @vllm 10240 1
Restart=always
RestartSec=5
# 메모리 압박 하에서도 워치독 자신은 살아남아야 함
Nice=-10
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
