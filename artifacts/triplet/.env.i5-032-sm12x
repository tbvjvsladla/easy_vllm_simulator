# Fresh0.32 candidate. Optional90-92 performance patches deferred; no GPU validation.
COMPOSE_PROJECT_NAME=vllm_i5-032-sm12x_project
CONTAINER_NAME=i5-032-sm12x-serving-container
MASTER_CONTAINER_NAME=i5-032-sm12x-master-container
SLAVE_CONTAINER_NAME=i5-032-sm12x-slave-container
VERSION=1.0.0
NVIDIA_VISIBLE_DEVICES=all
SERVING_IP=0.0.0.0
SERVING_PORT=8080
TIKTOKEN_ENABLED=false
SERVING_MODEL_NAME=deepseek-v4.1-flash-exl3
CONFIG_FILE=i5-032-sm12x
IMAGE_TAG=easy-vllm:0.32.0-cu133-aarch64-source-sm12x
VLLM_REF=5df63a7203cdb9328d824a27b682e77c7b9928be
SM12X_PORT=1
BUILD_DOCKERFILE=Dockerfile.source-build-sm12x
BUILD_JOBS=4
VLLM_EXL3_MOE_KERNEL=native
DSV41_CACHE_GIB=0
DSV41_IO_THREADS=96
DSV41_CACHE_WAYS=4
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
VLLM_RAY_EXTRA_ENV_VAR_PREFIXES_TO_COPY=EXL3_,DSV41_,GLM53_,EXL3PORT_
VLLM_RAY_EXTRA_ENV_VARS_TO_COPY=PYTORCH_CUDA_ALLOC_CONF,MAX_NUM_BATCHED_TOKENS,NNODES,VLLM_EXL3_MOE_KERNEL
NCCL_BUFFSIZE=1048576
NCCL_LL128_BUFFSIZE=262144
NCCL_PROTO=^LL128
NCCL_MAX_NCHANNELS=8
EXL3PORT_MXFP8_BACKEND=auto
EXL3PORT_ENGRAM_PRESTAGE=1
EXL3PORT_ENGRAM_PRESTAGE_VERIFY=4
EXL3PORT_ENGRAM_EARLY=0
EXL3PORT_ENGRAM_PRESTAGE_CENSUS=0
DSV41_DENSE_GEMV=0
DSV41_MOE_PREP_FUSED=0
DSV41_P2B_COOP=2
DSV41_WOA_PREPACK=1
MAX_NUM_BATCHED_TOKENS=1536
NNODES=2
TORCH_CUDA_ARCH=12.1a
HINT_PARENT_BUILD_MANIFEST=output/multi/parent-build/i5-sm12x032/manifest.json
