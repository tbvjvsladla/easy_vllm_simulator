COMPOSE_PROJECT_NAME=vllm_i5-a-kern_project
CONTAINER_NAME=i5-a-kern-serving-container
MASTER_CONTAINER_NAME=i5-a-kern-master-container
SLAVE_CONTAINER_NAME=i5-a-kern-slave-container
VERSION=1.0.0
NVIDIA_VISIBLE_DEVICES=all
SERVING_IP=0.0.0.0
SERVING_PORT=8080
TIKTOKEN_ENABLED=false
SERVING_MODEL_NAME=deepseek-v4.1-flash-exl3
CONFIG_FILE=i5-a-kern
IMAGE_TAG=easy-vllm:0.30.0-cu133-aarch64-source-sm12x
VLLM_REF=v0.30.0
SM12X_PORT=1
# --- 런타임 노브(plan_26100208 · 2차 이식 보고서 §4 — 우리 이식 패치가 읽는 것만) ---
VLLM_EXL3_MOE_KERNEL=native
DSV41_CACHE_GIB=0
DSV41_IO_THREADS=96
DSV41_CACHE_WAYS=4
MAX_NUM_BATCHED_TOKENS=1536
NNODES=2
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# Ray 워커 환경 전달(vllm/ray/ray_env.py: 기본 접두 VLLM_/NCCL_/HF_ — EXL3_·DSV41_ 는 목록에 추가)
VLLM_RAY_EXTRA_ENV_VAR_PREFIXES_TO_COPY=EXL3_,DSV41_,GLM53_,EXL3PORT_
VLLM_RAY_EXTRA_ENV_VARS_TO_COPY=PYTORCH_CUDA_ALLOC_CONF,MAX_NUM_BATCHED_TOKENS,NNODES,VLLM_EXL3_MOE_KERNEL
BUILD_DOCKERFILE=Dockerfile.source-build
EXL3PORT_ENGRAM_PRESTAGE=1
EXL3PORT_ENGRAM_PRESTAGE_VERIFY=4
VLLM_USE_BREAKABLE_CUDAGRAPH=1
DSV41_P2B_COOP=2
DSV41_WOA_PREPACK=1
NCCL_BUFFSIZE=1048576
NCCL_LL128_BUFFSIZE=262144
NCCL_PROTO=^LL128
NCCL_MAX_NCHANNELS=8
EXL3PORT_MXFP8_BACKEND=auto
DSV41_DENSE_GEMV=1
DSV41_MOE_PREP_FUSED=1
