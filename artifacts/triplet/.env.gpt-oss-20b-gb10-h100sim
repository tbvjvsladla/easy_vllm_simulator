# ═════════════════════════════════════════════════════════════════════
# vLLM 서버 환경 설정 — gpt-oss-20b-gb10-h100sim (vllm-recipe-explorer 생성)
# ═════════════════════════════════════════════════════════════════════

# ─────────────── 0) 프로젝트, 컨테이너, env파일 이름 ─────────────────────
COMPOSE_PROJECT_NAME=vllm_gpt-oss-20b-gb10-h100sim_project
CONTAINER_NAME=gpt-oss-20b-gb10-h100sim-serving-container
VERSION=1.0.0
NVIDIA_VISIBLE_DEVICES=all

# ─────────────── 1) 외부 노출 설정 (docker-compose 포트매핑) ─────────────
SERVING_IP=0.0.0.0
SERVING_PORT=8080

# ─────────────── 2) LLM 서빙 설정 ─────────────────────────────────────
TIKTOKEN_ENABLED=true
SERVING_MODEL_NAME=gpt-oss-20b
CONFIG_FILE=gpt-oss-20b-gb10-h100sim

# ─────────────── 3) 컨테이너 이미지 (필수) ───────────────────────────
# 비우면 compose 가 낡은 기본값으로 조용히 폴백해 **다른 vLLM 버전을 측정**한다.
IMAGE_TAG=easy-vllm:0.18.0-cu130-aarch64-wheel
