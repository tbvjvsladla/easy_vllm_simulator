# ⚠ 형상(shape) — 운영자 절대경로는 플레이스홀더로 가렸다.
#   <repo> · <manifest.nas_model_path> · <manifest-derived VLLM_VENV> 는 각자 환경에서 온다.
#   어떤 변수가 필요한지가 재현 정보이고, 값은 배포 대상이 아니다(계약 §3).
# ═════════════════════════════════════════════════════════════════════
# vLLM 서버 환경 설정 — fp8-off-512k (vllm-recipe-explorer 생성 · plane=native)
# ═════════════════════════════════════════════════════════════════════
# Docker 없이 호스트 프로세스로 서빙한다. 컨테이너/이미지 변수는 없다.

# ─────────────── 0) 실행 환경 ─────────────────────────────────────────
VLLM_VENV=<manifest-derived VLLM_VENV>
CONFIG_DIR=<repo>/output/single/configs
CUDA_VISIBLE_DEVICES=0,1

# ─────────────── 1) 외부 노출 설정 ───────────────────────────────────
SERVING_IP=0.0.0.0
SERVING_PORT=8080

# ─────────────── 2) LLM 서빙 설정 ─────────────────────────────────────
TIKTOKEN_ENABLED=false
SERVING_MODEL_NAME=qwen38fn-fp8
CONFIG_FILE=fp8-off-512k
