# ═════════════════════════════════════════════════════════════════════
# vLLM 서버 환경 설정 — e-1m-kvfp8-e1combo (vllm-recipe-explorer 생성)
# ═════════════════════════════════════════════════════════════════════

# ─────────────── 0) 프로젝트, 컨테이너, env파일 이름 ─────────────────────
COMPOSE_PROJECT_NAME=vllm_e-1m-kvfp8-e1combo_project
CONTAINER_NAME=e-1m-kvfp8-e1combo-serving-container
#multi smoke 워치독 필터 정본(관례: <cell>-master-container)
MASTER_CONTAINER_NAME=e-1m-kvfp8-e1combo-master-container
SLAVE_CONTAINER_NAME=e-1m-kvfp8-e1combo-slave-container
VERSION=1.0.0
NVIDIA_VISIBLE_DEVICES=all

# ─────────────── 1) 외부 노출 설정 (docker-compose 포트매핑) ─────────────
SERVING_IP=0.0.0.0
SERVING_PORT=8080

# ─────────────── 2) LLM 서빙 설정 ─────────────────────────────────────
#DS4F = harmony/tiktoken 불요(gpt-oss 전용)
TIKTOKEN_ENABLED=false
SERVING_MODEL_NAME=deepseek-v4-flash-0731
CONFIG_FILE=e-1m-kvfp8-e1combo

# ─────────────── 3) 컨테이너 이미지 (필수) ───────────────────────────
# 비우면 compose 가 낡은 기본값으로 조용히 폴백해 **다른 vLLM 버전을 측정**한다.
#캠페인 빌드 이미지(2026-09-08 · attempt-build · smoke 미중재)
IMAGE_TAG=easy-vllm:0.29.0rc6-cu133-aarch64-source
