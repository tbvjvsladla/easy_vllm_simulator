# vLLM 멀티노드 서버 env — gpt-oss-120b-gb10 (TP=2 · P5)
# Band3(모델 트리플렛) — 서브 전파 금지(policy:MODEL_TRIPLET_NO_SUB_PROPAGATION).
COMPOSE_PROJECT_NAME=vllm_gpt-oss-20b-gb10_multi
MASTER_CONTAINER_NAME=gpt-oss-20b-gb10-master-container
SLAVE_CONTAINER_NAME=gpt-oss-20b-gb10-slave-container
VERSION=1.0.0
NVIDIA_VISIBLE_DEVICES=all
SERVING_IP=0.0.0.0
SERVING_PORT=8080
TIKTOKEN_ENABLED=true
SERVING_MODEL_NAME=gpt-oss-20b
CONFIG_FILE=gpt-oss-20b-gb10
# 비우면 compose 가 낡은 기본값(0.27.1-source)으로 조용히 폴백해 다른 vLLM 버전을 측정한다.
IMAGE_TAG=easy-vllm:0.18.0-cu130-aarch64-wheel
# ★ 빌드 트랙 선택 — compose 기본값은 `Dockerfile.source-build`(콤보②③)다. 0.18.0 wheel 트랙은
#   이 줄이 **필수**이며, 없으면 태그는 `-wheel` 인데 내용은 0.27.1 소스빌드가 된다
#   (2026-09-04 실측: 엔진이 `v0.27.2.dev0+g6e448d0ea` 로 떴고 양 노드 0.18.0 태그가 그 내용으로
#    덮였다 — 태그는 가변 포인터라 이 불일치가 조용히 성립한다).
BUILD_DOCKERFILE=Dockerfile
