# ═════════════════════════════════════════════════════════════════════
# vLLM 서버 환경 설정 — nv4-off-1m (vllm-recipe-explorer 생성 · plane=native)
# ═════════════════════════════════════════════════════════════════════
# Docker 없이 호스트 프로세스로 서빙한다. 컨테이너/이미지 변수는 없다.

# ─────────────── 0) 실행 환경 ─────────────────────────────────────────
VLLM_VENV=<manifest.nodes[].work_dir>/.venv
CONFIG_DIR=<manifest.nodes[].work_dir>/output/single/configs
CUDA_VISIBLE_DEVICES=0,1

# ─────────────── 1) 외부 노출 설정 ───────────────────────────────────
SERVING_IP=0.0.0.0
SERVING_PORT=8080

# ─────────────── 2) LLM 서빙 설정 ─────────────────────────────────────
TIKTOKEN_ENABLED=false
SERVING_MODEL_NAME=qwen38fn-nvfp4
CONFIG_FILE=nv4-off-1m
