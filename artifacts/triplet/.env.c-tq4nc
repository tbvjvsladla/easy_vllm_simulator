# ═════════════════════════════════════════════════════════════════════
# vLLM 서버 환경 설정 — c-tq4nc (vllm-recipe-explorer 생성)
# ═════════════════════════════════════════════════════════════════════

# ─────────────── 0) 프로젝트, 컨테이너, env파일 이름 ─────────────────────
COMPOSE_PROJECT_NAME=vllm_c-tq4nc_project
CONTAINER_NAME=c-tq4nc-serving-container
VERSION=1.0.0
NVIDIA_VISIBLE_DEVICES=all

# ─────────────── 1) 외부 노출 설정 (docker-compose 포트매핑) ─────────────
SERVING_IP=0.0.0.0
SERVING_PORT=8000

# ─────────────── 2) LLM 서빙 설정 ─────────────────────────────────────
TIKTOKEN_ENABLED=true
SERVING_MODEL_NAME=qwen3-4b
CONFIG_FILE=c-tq4nc

# ─────────────── 3) 컨테이너 이미지 (필수) ───────────────────────────
# 비우면 compose 가 낡은 기본값으로 조용히 폴백해 **다른 vLLM 버전을 측정**한다.
IMAGE_TAG=easy-vllm:0.26.0-cu132-aarch64-source
