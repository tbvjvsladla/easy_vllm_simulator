{
  "schema_version": 1,
  "project_name": "easy_vllm_simulator",
  "wiki_dir": "__llm-wiki",
  "source_roots": [
    "docs/plan",
    "docs/devlog",
    "docs/testlog",
    "docs/simlog",
    "sync_staging/library_mirror",
    "seed"
  ],
  "excluded_roots": [
    "docs/plan/example.md",
    "docs/devlog/example.md",
    "docs/testlog/example.md",
    "docs/simlog/example.md",
    "seed/wiki-desk",
    "seed/caveman",
    "seed/hermes-subagent-control-plane",
    "seed/안드레카파시 클로드"
  ],
  "source_suffixes": [
    ".md"
  ],
  "authority_rules": [
    {
      "pattern": "sync_staging/library_mirror/**",
      "document_type": "sub-doc",
      "authority_rank": 70,
      "role": "sub-node-record"
    },
    {
      "pattern": "docs/devlog/**",
      "document_type": "devlog",
      "authority_rank": 100,
      "role": "execution-narrative"
    },
    {
      "pattern": "docs/testlog/**",
      "document_type": "testlog",
      "authority_rank": 85,
      "role": "evidence-verdict"
    },
    {
      "pattern": "docs/plan/**",
      "document_type": "plan",
      "authority_rank": 55,
      "role": "intent"
    },
    {
      "pattern": "docs/simlog/**",
      "document_type": "simlog",
      "authority_rank": 40,
      "role": "raw-trial"
    },
    {
      "pattern": "seed/**",
      "document_type": "seed",
      "authority_rank": 25,
      "role": "reference-input"
    }
  ],
  "fallback": {
    "document_type": "reference",
    "authority_rank": 0,
    "role": "reference"
  },
  "copy_policy": "path_reference",
  "frontmatter_aliases": {
    "related_plan": [
      "plan"
    ]
  },
  "filename_pattern": "^(?<prefix>[a-z][a-z_]*)_(?<yymmddhh>\\d{8})(?:_\\d{2}_\\d{2})?_(?<title>.+)\\.md$",
  "layout": {
    "cards_dir": "cards",
    "cache_dir": ".cache",
    "archive_dir": "archive"
  },
  "search": {
    "bm25_k1": 1.2,
    "bm25_b": 0.75,
    "field_boost": {
      "title": 3,
      "heading": 2,
      "meta": 1.5,
      "body": 1
    },
    "authority_weight": 0.01,
    "span_max_lines": 40,
    "result_limit": 10,
    "spans_per_result": 2
  },
  "node_mirror_root": "sync_staging/library_mirror",
  "node_intake_roots": [
    "docs/plan",
    "docs/devlog",
    "docs/testlog",
    "docs/simlog"
  ],
  "node_intake_excluded": [
    "docs/plan/example.md",
    "docs/devlog/example.md",
    "docs/testlog/example.md",
    "docs/simlog/example.md"
  ]
}
