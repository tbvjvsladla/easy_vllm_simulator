{
  "schema_version": 1,
  "project_name": "example-project",
  "wiki_dir": "__llm-wiki",
  "source_roots": [
    "docs"
  ],
  "excluded_roots": [
    "docs/private"
  ],
  "source_suffixes": [
    ".md"
  ],
  "authority_rules": [
    {
      "pattern": "docs/reports/**",
      "document_type": "report",
      "authority_rank": 90,
      "role": "result-report"
    },
    {
      "pattern": "docs/decisions/**",
      "document_type": "decision",
      "authority_rank": 70,
      "role": "decision-record"
    },
    {
      "pattern": "docs/plans/**",
      "document_type": "plan",
      "authority_rank": 40,
      "role": "intent"
    }
  ],
  "fallback": {
    "document_type": "reference",
    "authority_rank": 0,
    "role": "reference"
  },
  "copy_policy": "path_reference",
  "frontmatter_aliases": {
    "related_plan": [
      "plan"
    ]
  },
  "filename_pattern": "^(?<prefix>[a-z][a-z_]*)_(?<yymmddhh>\\d{8})_(?<title>.+)\\.md$",
  "layout": {
    "cards_dir": "cards",
    "cache_dir": ".cache",
    "archive_dir": "archive"
  },
  "search": {
    "bm25_k1": 1.2,
    "bm25_b": 0.75,
    "field_boost": {
      "title": 3,
      "heading": 2,
      "meta": 1.5,
      "body": 1
    },
    "authority_weight": 0.01,
    "span_max_lines": 40,
    "result_limit": 10,
    "spans_per_result": 2
  }
}
