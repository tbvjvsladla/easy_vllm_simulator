# .env.exaone45-33b — LG/EXAONE-4.5-33B 모델 env (Band3-PURE · S6 env-split 검증).
# ⚠ S6: 클러스터 변수(MASTER_HOST_IP·SLAVE_HOST_IP·SSH_USER·RAY_PORT·RAY/alloc 튜닝)는 여기 없음 —
#    .env.cluster(Band2, render_dockerfile.py --cluster-envfile 가 manifest.nodes 에서 생성)가 제공.
#    이 파일은 모델/컨테이너-keyed 값(Band3)만 보유. (전례 .env.axx40 는 클러스터 변수 인라인 = pre-S6.)

# ── 이미지 (버전-keyed, 한 이미지가 모든 모델 서빙) ──
IMAGE_TAG=easy-vllm:0.23.0-cu132-aarch64-source
BUILD_DOCKERFILE=Dockerfile.source-build
# ↑ stock 이미지(파생-이미지 mmshim 폐기 — 이미지 네이밍 불변식). EXAONE-4.5 호환 = 런타임 패치
#   configs/exaone45-33b_patch.py + serve_runner→arm_patch.sh arming(.pth, 모든 프로세스). 헌법 모델구동 런타임 패치 따름정리.
COMPOSE_PROJECT_NAME=mn_exaone45_33b

# ── 서빙 엔드포인트 (모델-keyed) ──
SERVING_IP=0.0.0.0
SERVING_PORT=8930
SERVING_MODEL_NAME=exaone-4.5
CONFIG_FILE=exaone45-33b
MASTER_CONTAINER_NAME=mn-exaone45-33b-master
SLAVE_CONTAINER_NAME=mn-exaone45-33b-slave

# ── tiktoken 불요 (EXAONE BPE) ──
TIKTOKEN_ENABLED=false
