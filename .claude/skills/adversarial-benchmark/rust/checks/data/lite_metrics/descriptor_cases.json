[
 {
  "id": "01-load-current-offset",
  "purpose": "valid JSON after 8 garbage bytes: read starts at the shared current offset, ends at EOF, fd closed",
  "files": {
   "a.json": "GARBAGE\n{\"completed\": 1, \"x\": [1, 2]}\n"
  },
  "opens": [
   {
    "sym": "A",
    "file": "a.json",
    "access": "r",
    "offset": 8,
    "dup": "B"
   }
  ],
  "calls": [
   {
    "op": "_load_json",
    "path": {
     "sym": "A"
    }
   }
  ],
  "stdout": null,
  "observe_offsets": [
   "B"
  ],
  "observe_closed": [
   "A",
   "B"
  ],
  "observe_stdio": [],
  "reuse": null,
  "expected": {
   "exit": 0,
   "result": {
    "results": [
     {
      "kind": "value",
      "value": {
       "completed": 1,
       "x": [
        1,
        2
       ]
      }
     }
    ],
    "offsets": {
     "B": 38
    },
    "open_after": {
     "A": false,
     "B": true
    },
    "stdio_open_after": {}
   }
  }
 },
