{
  "_template_note": "추적 PII-free 템플릿. render_sub_env.py 가 {{ WORKSPACE_PATH }}/{{ NAS_MOUNT }} 를 채워 서브 .claude/settings.local.json(gitignored)으로 렌더. 스코프드 권한(블랭킷 dontAsk 아님). 메인이 ssh claude -p 로 이 allowlist 에 대해 비대화 실행. 헌법: settings.local.json 은 비추적 — 추적은 이 .template. ⚠ deny 는 best-effort 방어심층일 뿐 — Bash(bash:*)·Bash(python3:*) 와이드 allow(recipe 엔진·bash -n 에 필요)로 우회 가능(claude 권한=호출 prefix 매칭). '모델 다운로드 금지·원격 push 금지'의 구속력은 페르소나(CLAUDE.md)와 서브 origin 부재에 있다(권한층 아님). model=sonnet(표준 컨텍스트) 핀 — 유저 settings 의 sonnet[1m] 는 usage-credit(429) 게이트라 서브 빌드워커는 표준 컨텍스트 사용(메인이 --model 미지정해도 ssh claude -p 동작). 환경 맞게 override 가능.",
  "model": "sonnet",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read({{ WORKSPACE_PATH }}/**)",
      "Read({{ NAS_MOUNT }}/**)",
      "Write({{ WORKSPACE_PATH }}/configs/**)",
      "Edit({{ WORKSPACE_PATH }}/configs/**)",
      "Write({{ WORKSPACE_PATH }}/envs/**)",
      "Edit({{ WORKSPACE_PATH }}/envs/**)",
      "Write({{ WORKSPACE_PATH }}/tasks/**)",
      "Edit({{ WORKSPACE_PATH }}/tasks/**)",
      "Bash(docker compose:*)",
      "Bash(docker:*)",
      "Bash(python3:*)",
      "Bash(bash:*)",
      "Bash(nvidia-smi:*)",
      "Bash(ray:*)",
      "Bash(ib_write_bw:*)",
      "Bash(md5sum:*)",
      "Bash(sha256sum:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(test:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git rev-parse:*)"
    ],
    "deny": [
      "Write({{ WORKSPACE_PATH }}/Dockerfile)",
      "Edit({{ WORKSPACE_PATH }}/Dockerfile)",
      "Edit({{ WORKSPACE_PATH }}/Dockerfile.source-build)",
      "Write({{ WORKSPACE_PATH }}/docker-compose.yaml)",
      "Edit({{ WORKSPACE_PATH }}/docker-compose.yaml)",
      "Write({{ WORKSPACE_PATH }}/requirements.txt)",
      "Edit({{ WORKSPACE_PATH }}/requirements.txt)",
      "Edit({{ WORKSPACE_PATH }}/configs/serve_runner.sh)",
      "Edit({{ WORKSPACE_PATH }}/configs/debug-init.sh)",
      "Edit({{ WORKSPACE_PATH }}/.claude/**)",
      "Write({{ WORKSPACE_PATH }}/.claude/**)",
      "Edit({{ WORKSPACE_PATH }}/CLAUDE.md)",
      "Write({{ WORKSPACE_PATH }}/CLAUDE.md)",
      "Edit({{ WORKSPACE_PATH }}/Agent_Card.json)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(huggingface-cli:*)",
