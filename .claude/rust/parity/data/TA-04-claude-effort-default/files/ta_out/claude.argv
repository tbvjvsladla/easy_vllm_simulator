call 1 argv: [-p] [/effort status] [--model] [sonnet] [--output-format] [stream-json] [--max-turns] [3] [--allowedTools] [Read,Bash] [--verbose]
watchdog=unset
call 2 argv: [-p] [read-only runtime probe] [--model] [sonnet] [--output-format] [json] [--max-turns] [3] [--allowedTools] [Read,Bash]
watchdog=unset
