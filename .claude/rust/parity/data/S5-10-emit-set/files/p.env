# generated by blackbox_thermal.py -- 편집 금지(재생성으로 갱신)
# 규칙: 값>=임계면 bucket+1(상한 cap), 아니면 bucket-decay(하한 0). TRIP <=> bucket>=sustain
# 축은 서로 독립이다 -- 어느 하나라도 TRIP 이면 kill(하드다운은 어느 축으로든 온다).
# ⚠ GPU '온도'는 트립 축이 **아니다**(실측 반증 — blackbox_thermal.py 헤더 §음성정직 1).
# 출처: measured:decay=1 이 분리비 23.8배로 최대(decay=2 는 23.7, 연속스트릭은 21.8)
BB_TP_BUCKET_DECAY=1
# 출처: measured:docs/logs/main/samples 23일 1Hz 전수(2026-07-31~08-23) 그리드 탐색
BB_TP_GPU_PWR_W=80
# 출처: measured:생존22일 최대버킷 13 vs 사건일 309 의 기하평균 부근
BB_TP_GPU_SUSTAIN_S=90
# 출처: design:수집기와 동일 격자
BB_TP_POLL_INTERVAL_S=1
# 출처: calibrated:2026-09-09 — 장애 스파이크 종점 97.8°C(acpitz) + 마진 · 포럼 하드오프 사례는 센서 결함 진단 동반(정상 관리 상승과 다른 사건)
BB_TP_SOC_HARD_C=99
# 출처: inherited:blackbox_eta.DEFAULTS['debounce_polls'] 와 동일 개념(1Hz x 3폴)
BB_TP_SOC_HARD_POLLS=3
# 출처: calibrated:2026-09-09 — 술어(버킷 지속초)는 유지 · warn 재기준으로 진성 이탈만 걸림 · 장애 시그니처는 급상승(2°C/s)이라 hard 축이 담당
BB_TP_SOC_SUSTAIN_S=30
# 출처: calibrated:2026-09-09 — EC 팬 커브 100%@97°C(포럼 377044 펌웨어 복구 · 3버전 동일) + 이 유닛 8일 682k samples(max 97°C·무사고) · testlog_26090904 후속
BB_TP_SOC_WARN_C=95
# 출처: derived:수집기 1Hz 격자 + 여유
BB_TP_STALE_AFTER_S=10
# 파생값 — 손으로 적지 않는다(출처: derived:2 x gpu/soc sustain — 회복이 유계이도록(손으로 적지 않는다))
BB_TP_GPU_PWR_DW=800
BB_TP_SOC_PLAUSIBLE_MIN_C=-40
BB_TP_SOC_PLAUSIBLE_MAX_C=150
BB_TP_GPU_BUCKET_CAP=180
BB_TP_SOC_BUCKET_CAP=60
# ⚠ 미교정 파라미터(외부 보고 역산 — 이 노드 실측 분포 없음):
BB_TP_UNCALIBRATED=""
# GPU 전력 축 무장: unknown-gpu:보정 판정 불가 → 종전 무장 유지
BB_TP_GPU_AXIS=1
