# ═════════════════════════════════════════════════════════════════════
# vLLM 서버 환경 설정 — gpt-oss-20b (단일노드 스모크용)
# ═════════════════════════════════════════════════════════════════════

# ─────────────── 0) 프로젝트, 컨테이너, env파일 이름 ─────────────────────
COMPOSE_PROJECT_NAME=vllm_gpt-oss-20b_project
CONTAINER_NAME=gpt-oss-20b-serving-container
VERSION=1.0.0
NVIDIA_VISIBLE_DEVICES=all

# ─────────────── 1) 외부 노출 설정 (docker-compose 포트매핑) ─────────────
SERVING_IP=0.0.0.0
SERVING_PORT=8901

# ─────────────── 2) LLM 서빙 설정 ─────────────────────────────────────
TIKTOKEN_ENABLED=true
SERVING_MODEL_NAME=gpt-oss-20b
CONFIG_FILE=gpt-oss-20b-normal
