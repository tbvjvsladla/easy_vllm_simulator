# ═════════════════════════════════════════════════════════════════════
# vLLM 서버 환경 설정 — 작성 예시 (멀티 노드 브랜치)
# ═════════════════════════════════════════════════════════════════════
#
# 이 파일은 실제 서빙용이 아닌 작성 가이드입니다.
# 새 모델 서빙 설정 추가 시 이 파일을 복사하여 사용하세요:
#
#   cp envs/.env.example envs/.env.<config-name>
#
# <config-name> 형식: <모델명>
#   예: Qwen3.5-122B-A10B-FP8, GLM-4.5-Air-FP8, Qwen3.5-397B-A17B-NVFP4
#
# ⚠️ 멀티 노드 설계 원칙:
#   이 env 파일 1개를 master/slave 양 노드에 동일하게 배포합니다.
#   --profile 플래그(master/slave)로 역할을 선택하며, docker-compose가
#   profiles에 따라 MASTER_HOST_IP / SLAVE_HOST_IP 중 올바른 IP를
#   VLLM_HOST_IP로 자동 매핑합니다. env 파일을 노드별로 분리할 필요 없음.
#
# 주의: = 주변에 공백을 넣지 마세요. Docker Compose가 공백을 값에 포함시킵니다.
#   잘못됨: SERVING_PORT = 9010
#   올바름: SERVING_PORT=9010

# ─────────────────────────────────────────────────────────────────────
# 0) 프로젝트/컨테이너 식별
# ─────────────────────────────────────────────────────────────────────
#
# COMPOSE_PROJECT_NAME: 모델별로 반드시 고유해야 함
#   같은 노드에서 서로 다른 모델을 번갈아 서빙할 때 컨테이너/네트워크
#   충돌을 방지하는 용도. 프로젝트 이름이 같으면 docker compose up 시
#   기존 컨테이너가 교체되어 죽을 수 있음.
#
#   규칙: 소문자, 숫자, 하이픈(-), 언더스코어(_)만 허용 (대문자/점 불가)
COMPOSE_PROJECT_NAME=vllm_<모델명-소문자>_project

# CONFIG_FILE: 이 배포의 핵심 식별자
#   다음 세 가지 파일의 접두사로 사용됨:
#     - envs/.env.<CONFIG_FILE>           (이 env 파일 자체)
#     - configs/<CONFIG_FILE>.sh          (모델별 사전 처리 + vllm serve)
#     - configs/<CONFIG_FILE>.yaml        (vllm serve --config 로 로드)
#
#   ⚠️ env 파일명과 정확히 일치해야 함.
#   예: envs/.env.Qwen3.5-122B-A10B-FP8 → CONFIG_FILE=Qwen3.5-122B-A10B-FP8
CONFIG_FILE=<config-name>

# MASTER_CONTAINER_NAME / SLAVE_CONTAINER_NAME:
#   docker ps/exec에서 사용할 컨테이너 이름
#   master/slave 별도 지정하여 혼동 방지
#   예: vllm-master-Qwen3.5-122B / vllm-slave-Qwen3.5-122B
MASTER_CONTAINER_NAME=vllm-master-<모델명-짧게>
SLAVE_CONTAINER_NAME=vllm-slave-<모델명-짧게>

VERSION=1.0.0
NVIDIA_VISIBLE_DEVICES=all

# ─────────────────────────────────────────────────────────────────────
# 1) 포트 설정
# ─────────────────────────────────────────────────────────────────────
#
# SERVING_IP: vLLM이 바인딩할 호스트 IP
#   0.0.0.0 = 모든 인터페이스에서 접속 허용 (기본 권장)
SERVING_IP=0.0.0.0

# SERVING_PORT: vLLM이 바인딩할 포트
#   network_mode: host이므로 컨테이너 포트 = 호스트 포트
#
#   포트 할당 규약:
#     89XX 시리즈: 싱글 노드 서빙용 (main 브랜치)
#     90XX 시리즈: 멀티 노드 서빙용 (multi-node 브랜치, 현재)
#
#   모델별 포트 예시 (10단위 간격으로 배치하여 variant 확장성 확보):
#     9010: Qwen3.5-122B-A10B-FP8
#     9020: GLM-4.5-Air-FP8
#     9030: Qwen3.5-397B-A17B-NVFP4
#
# ⚠️ slave 노드에서는 vllm serve를 실행하지 않으므로 SERVING_PORT가
#   실질적으로 사용되지 않음. 그러나 env 파일을 master/slave 양 노드에
#   동일하게 배포하는 구조이므로 이 값은 자연스럽게 공유됨.
SERVING_PORT=<호스트포트>

# ─────────────────────────────────────────────────────────────────────
# 2) 분산 클러스터 설정 (멀티 노드 전용)
# ─────────────────────────────────────────────────────────────────────
#
# ★ 배포 시 수정 필수 ★
# 이 두 IP만 고객/현장 환경에 맞게 수정하면 다른 DGX Spark 클러스터에서도
# 동일한 env 파일을 재사용할 수 있습니다.
#
# MASTER_HOST_IP: master 노드의 CX7(RoCE) 내부망 IP
#   - master 프로필에서는 VLLM_HOST_IP로 자동 주입됨
#   - slave 프로필에서는 HEAD_NODE_IP로 자동 주입되어 Ray head 접속에 사용
MASTER_HOST_IP=192.168.100.10

# SLAVE_HOST_IP: slave 노드의 CX7(RoCE) 내부망 IP
#   - slave 프로필에서 VLLM_HOST_IP로 자동 주입됨 (자기 자신의 IP)
SLAVE_HOST_IP=192.168.100.11

# RAY_PORT: Ray 클러스터 head의 바인딩 포트
#   일반적으로 6379 기본값 유지. 포트 충돌 환경에서만 변경.
RAY_PORT=6379

# ─────────────────────────────────────────────────────────────────────
# 3) LLM 서빙 설정
# ─────────────────────────────────────────────────────────────────────
#
# SERVING_MODEL_NAME: OpenAI-compatible API 엔드포인트에 노출되는 모델 이름
#   클라이언트가 /v1/chat/completions 호출 시 "model" 필드에 지정할 값
#   master/slave 양쪽 모두 동일 (slave는 API를 노출하지 않지만 일관성 유지)
SERVING_MODEL_NAME=<API에 노출할 모델명>

# ─────────────────────────────────────────────────────────────────────
# 4) 모델별 추가 환경변수 (선택)
# ─────────────────────────────────────────────────────────────────────
#
# ⚠️ 대부분의 모델별 환경변수는 configs/<CONFIG_FILE>.sh 에서
#    export 하는 것을 권장합니다. 다음 경우에만 env 파일에 추가하세요:
#    1) docker-compose.yaml에서 컨테이너 시작 전에 주입이 필요한 경우
#    2) 여러 모델/배포에서 공유되는 전역적 성격의 설정
#
# 모델별 특수 런타임 플래그 예시 (configs/*.sh 쪽에서 관리 권장):
#   [Qwen3.5-397B-A17B-NVFP4]
#     VLLM_TEST_FORCE_FP8_MARLIN=1   (GB10/SM121에서 NVFP4 Marlin 강제)
#     PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
#     RAY_memory_monitor_refresh_ms=0
#
#   [GLM-4.5-Air-FP8]
#     VLLM_ATTENTION_BACKEND=XFORMERS  (flash infer 이슈 시 대체)

# TIKTOKEN_ENABLED: tiktoken 기반 토크나이저 사용 여부 (true/false)
#   GPT 계열 등 tiktoken을 사용하는 모델만 true로 설정
# TIKTOKEN_ENABLED=true

# ─────────────────────────────────────────────────────────────────────
# 5) 실행 방법 (참고)
# ─────────────────────────────────────────────────────────────────────
#
# 양 노드에 동일한 env 파일을 배포한 후, 각 노드에서:
#
#   # 메인 노드 (MASTER_HOST_IP 머신)
#   docker compose --env-file envs/.env.<CONFIG_FILE> --profile master up
#
#   # 서브 노드 (SLAVE_HOST_IP 머신)
#   docker compose --env-file envs/.env.<CONFIG_FILE> --profile slave up
#
# 디버그 모드 (Ray/vllm serve 수동 실행용):
#
#   docker compose --profile debug up -d
#   docker exec -it vllm_server bash
#   # env 파일 없이도 CX7 인터페이스에서 자기 IP를 자동 감지