# ═════════════════════════════════════════════════════════════════════
# vLLM 서버 환경 설정 — 작성 예시 (멀티 노드 브랜치)
# ═════════════════════════════════════════════════════════════════════
#
# 이 파일은 실제 서빙용이 아닌 작성 가이드입니다.
# 새 모델 서빙 설정 추가 시 이 파일을 복사하여 사용하세요:
#
#   싱글 노드: cp envs/.env.example envs/.env.<config-name>
#   멀티 노드: cp envs/.env.example envs/.env.<config-name>-master
#             cp envs/.env.example envs/.env.<config-name>-slave
#
# <config-name> 형식: <모델명>-<프로파일명>
#   예: Qwen3.5-122B-A10B-FP8-master, Qwen3.5-122B-A10B-FP8-slave
#
# 주의: = 주변에 공백을 넣지 마세요. Docker Compose가 공백을 값에 포함시킵니다.
#   잘못됨: SERVING_PORT = 9010
#   올바름: SERVING_PORT=9010

# ─────────────────────────────────────────────────────────────────────
# 0) 프로젝트/컨테이너 식별
# ─────────────────────────────────────────────────────────────────────
#
# COMPOSE_PROJECT_NAME: 모델별로 반드시 고유해야 함
#   멀티 노드에서는 master와 slave가 동일한 값을 공유 (같은 클러스터 논리 단위)
#   서빙하는 모델이 다를시 프로젝트 이름도 달리할 것 
#   프로젝트 이름이 같은게 있으면  docker compose up 시 기존 컨테이너가 교체되어 죽음 
#                                                  
#   규칙: 소문자, 숫자, 하이픈(-), 언더스코어(_)만 허용 (대문자/점 불가)
COMPOSE_PROJECT_NAME=vllm_<모델명-소문자>_project

# CONTAINER_NAME: docker ps/exec에서 사용할 컨테이너 이름
#   멀티 노드에서는 -master/-slave 접미사로 구분
#   예: qwen3.5-122b-a10b-fp8-serving-master
#       qwen3.5-122b-a10b-fp8-serving-slave
CONTAINER_NAME=<모델명>-serving-container

VERSION=1.0.0
NVIDIA_VISIBLE_DEVICES=all

# ─────────────────────────────────────────────────────────────────────
# 1) 포트 설정
# ─────────────────────────────────────────────────────────────────────
#
# SERVING_PORT: vLLM이 바인딩할 포트
#   network_mode: host이므로 컨테이너 포트 = 호스트 포트
#   포트 할당 규약:
#     89XX 시리즈: 싱글 노드 서빙용 (main 브랜치)
#     90XX 시리즈: 멀티 노드 서빙용 (multi-node 브랜치, 현재)
#
# ⚠️ 멀티 노드 운용 참고:
#   slave 노드에서는 vllm serve를 실행하지 않으므로 SERVING_PORT가
#   실질적으로 사용되지 않음. 그러나 env 파일 구조의 대칭성 및
#   향후 역할 스위칭 대비를 위해 master와 동일 값을 명시적으로 기록.
SERVING_IP=0.0.0.0
SERVING_PORT=<호스트포트>

# ─────────────────────────────────────────────────────────────────────
# 2) 분산 클러스터 설정 (멀티 노드 전용)
# ─────────────────────────────────────────────────────────────────────
#
# HEAD_NODE_IP: Ray head 노드의 CX7 내부망 IP
#   - master에서는 "이 값으로 head를 띄운다"
#   - slave에서는 "이 값의 head에 접속한다"
#   양쪽 env 파일에 동일 값을 기록
HEAD_NODE_IP=192.168.100.10

# VLLM_HOST_IP: 이 컨테이너(노드)의 CX7 내부망 IP
#   각 노드의 자기 자신 IP를 기록 (Ray 클러스터에 등록되는 주소)
#   master:  192.168.100.10
#   slave:   192.168.100.11
VLLM_HOST_IP=<노드별_CX7_IP>

# ─────────────────────────────────────────────────────────────────────
# 3) LLM 서빙 설정
# ─────────────────────────────────────────────────────────────────────
#
# TIKTOKEN_ENABLED: tiktoken 기반 토크나이저 사용 여부 (true/false)
#   GPT 계열 등 tiktoken을 사용하는 모델만 true로 설정
# TIKTOKEN_ENABLED=true

# SERVING_MODEL_NAME: API 엔드포인트에 노출되는 모델 이름
#   master/slave 동일 (slave는 API를 노출하지 않지만 일관성 유지)
SERVING_MODEL_NAME=<API에 노출할 모델명>

# CONFIG_FILE: sh 파일명을 결정하는 키
#   이 값으로 configs/<CONFIG_FILE>.sh를 참조하여 실행
#   env 파일명(.env.<CONFIG_FILE>)과 일치해야 함
#
# ⚠️ yaml 파일 참조 규칙 (멀티 노드):
#   CONFIG_FILE에 -master / -slave 접미사가 붙어 있어도,
#   yaml은 접미사 없는 버전을 공유 참조함.
#   sh 파일 내에서 ${CONFIG_FILE%-master} / ${CONFIG_FILE%-slave}로
#   접미사를 제거한 뒤 yaml을 로드.
#
#   예: CONFIG_FILE=Qwen3.5-122B-A10B-FP8-master
#       → configs/Qwen3.5-122B-A10B-FP8-master.sh 실행
#       → configs/Qwen3.5-122B-A10B-FP8.yaml 로드 (suffix 제거)
CONFIG_FILE=<config-name>
