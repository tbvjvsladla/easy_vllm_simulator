# ═════════════════════════════════════════════════════════════════════
# vLLM 서버 환경 설정 — 작성 예시
# ═════════════════════════════════════════════════════════════════════
#
# 이 파일은 실제 서빙용이 아닌 작성 가이드입니다.
# 새 모델 서빙 설정 추가 시 이 파일을 복사하여 사용하세요:
#   cp envs/.env.example envs/.env.<config-name>
#
# <config-name> 형식: <모델명>-<프로파일명>
#   예: gpt-oss-120b-normal, Qwen3.5-35B-A3B-normal
#
# 주의: = 주변에 공백을 넣지 마세요. Docker Compose가 공백을 값에 포함시킵니다.
#   잘못됨: SERVING_PORT = 8900
#   올바름: SERVING_PORT=8900

# ─────────────── 0) 프로젝트/컨테이너 식별 ──────────────────────────
#
# COMPOSE_PROJECT_NAME: 모델별로 반드시 고유해야 함
#   같은 이름을 쓰면 docker compose up 시 기존 컨테이너가 교체되어 죽음
#   규칙: 소문자, 숫자, 하이픈(-), 언더스코어(_)만 허용 (대문자/점 불가)
#   권장 패턴: vllm_<모델명-소문자>_project
COMPOSE_PROJECT_NAME=vllm_<모델명-소문자>_project

# CONTAINER_NAME: docker exec 시 사용할 컨테이너 이름
CONTAINER_NAME=<모델명>-serving-container

VERSION=1.0.0
NVIDIA_VISIBLE_DEVICES=all

# ─────────────── 1) 외부 노출 설정 (docker-compose 포트매핑) ─────────
#
# SERVING_PORT: 호스트에서 접근할 포트 (컨테이너 내부는 항상 8000)
#   모델마다 다른 포트를 지정해야 동시 서빙 가능
#   WSL2 환경에서는 Hyper-V 예약 포트와 충돌할 수 있으므로 주의
SERVING_IP=0.0.0.0
SERVING_PORT=<호스트포트>

# ─────────────── 2) LLM 서빙 설정 ─────────────────────────────────
#
# TIKTOKEN_ENABLED: tiktoken 기반 토크나이저 사용 여부 (true/false)
#   GPT 계열 등 tiktoken을 사용하는 모델만 true로 설정
#   생략 시 sh에서 false로 취급됨
# TIKTOKEN_ENABLED=true

# SERVING_MODEL_NAME: API 엔드포인트에 노출되는 모델 이름
#   curl 등으로 호출 시 "model": "<이 값>" 으로 지정
SERVING_MODEL_NAME=<API에 노출할 모델명>

# CONFIG_FILE: sh/yaml 파일명을 결정하는 키
#   이 값으로 configs/<config-name>.sh, configs/<config-name>.yaml을 참조
#   이 env 파일명(.env.<config-name>)과도 일치해야 함
CONFIG_FILE=<config-name>
