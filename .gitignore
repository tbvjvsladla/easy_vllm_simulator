*.egg
dist/
build/
.eggs/

# 가상 환경
.venv/
venv/
env/

# uv
uv.lock

# 타입 체커 / 린터
.mypy_cache/
.pytype/
.pyre/
.ruff_cache/

# 테스트
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Jupyter
.ipynb_checkpoints/

# ===========================================
# IDE / 에디터
# ===========================================
.vscode/
.idea/
*.swp
*.swo
*~
\#*\#
.\#*

# ===========================================
# 운영체제
# ===========================================
.DS_Store
Thumbs.db
[Dd]esktop.ini
.Trash-*
*:Zone.Identifier

# ===========================================
# 임시 파일 / 로그
# ===========================================
*.tmp
*.temp
*.bak
*.log
*.orig
temp/
seed/

# ===========================================
# docs — 작업 문서는 gitignore(브랜치 간 persist·통합, 빌딩블럭처럼).
# 폴더 스켈레톤 + 각 폴더 example.md(작성·명명 규칙)만 추적·배포. 규칙: .claude/rules/docs.md
# ===========================================
docs/*/*
!docs/*/example.md