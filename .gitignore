# ===========================================
# .claude 빌딩블럭 선별 추적 (배포 대상)
#   .claude/* 전체 무시 → rules/·skills/·schemas/ 디렉토리 재포함 → 그 안의 사적·산출 파일만 재제외.
#   (재포함은 부모 디렉토리부터: 부모가 제외되면 자식은 다시 추적될 수 없다.)
#   규칙 근거: docs/plan/plan_2026062205_1 §4, docs/plan/plan_26072506_* Phase 1
# ===========================================
.claude/*
!.claude/rules/
!.claude/skills/
!.claude/schemas/
!.claude/policies/
# 추적 git 훅(core.hooksPath = .claude/hooks). 훅은 배포 대상 빌딩블럭이다 — `.git/hooks` 는
#   클론에 실리지 않으므로 추적 디렉터리에 두고 hooksPath 로 가리켜야 배포본에서도 산다.
!.claude/hooks/
.claude/schemas/*
!.claude/schemas/work-manifest.schema.json
!.claude/schemas/completion-manifest.schema.json
!.claude/schemas/side-effect-authorization.schema.json
!.claude/schemas/policy-registry.schema.json
!.claude/schemas/agent-control-request.schema.json
!.claude/schemas/agent-control-result.schema.json
.claude/policies/*
# C-4 비대칭 해소(2026-09-03): runtime/·predicates/·provenance/ 는 **이미 추적 중**이라 정상으로
#   보였을 뿐, `.claude/policies/*` 에 걸려 ignored-but-tracked 였다 — 신규 판정기를 `git add`
#   하면 조용히 no-op 이 됐다(실증: `git check-ignore -v .claude/policies/runtime/xxx_new.py`).
#   재포함은 부모→자식 순서이며, `*` 는 `/` 를 넘지 않으므로 디렉터리 재포함만으로 내부가 살아난다.
!.claude/policies/runtime/
!.claude/policies/predicates/
!.claude/policies/provenance/
!.claude/policies/registry.yaml
!.claude/policies/claim_bindings.json
# 분류표 원장(2026-09-12 · plan_26091210 §3.7). 위 C-4 비대칭의 같은 형태다 — 재포함 한 줄이
#   없으면 `git add` 가 조용히 no-op 이 되고, 원장이 추적되지 않으면 "이 교정이 어느 판정을
#   거쳤는가" 가 다음 사람에게 아예 보이지 않는다.
!.claude/policies/branch_layer_ledger.json
!.claude/policies/arch_variant_ledger.json
# 루트 표면 등록부(policy:ROOT_SURFACE_REGISTRY 의 단일 권위). `.claude/policies/*` 에 걸려
#   `git add` 가 조용히 no-op 이 되는 자리다 — 재포함이 없으면 등록부 자체가 배포되지 않는다.
!.claude/policies/root_registry.json
!.claude/policies/arch_variant_evidence/
!.claude/policies/arch_variant_evidence/*.json
# 재제외 (재포함 이후에 와야 적용됨 / 주석은 반드시 별도 줄 — 패턴 뒤 인라인 # 은 리터럴로 취급됨)
# 개인 로컬 설정(IP·allowlist)
.claude/settings.local.json
# PII 금지 term 목록(smoke_clone.sh·scan_forbidden_strings.py 공유 입력 — 실 PII 리터럴 보유, 배포 제외)
.claude/pii_terms.txt
# 사용자 실값(추적은 config.example.yaml 만)
.claude/skills/**/config.yaml
# 실 서브노드 에이전트-카드(추적은 sub_node/CLAUDE.template.md)
.claude/skills/**/sub_node/CLAUDE.md
# 런타임 피드백/상태 로그(저자 누적 런 데이터 — 클론은 빈 상태로 시작, writer 가 mkdir)
.claude/skills/**/feedback/
# recipe-explorer Phase 1/2 per-run 산출물(모델별 생성물·답안노출 방지 — 추적은 config.example.yaml + 스크립트 엔진만)
#   lockset*.json=인터뷰 lock-set(모델별 파라미터화 명명 lockset_<config>.json 포함) · candidates.json=LLM 후보 · parsed.json=config.json 파싱 산물
.claude/skills/**/lockset*.json
.claude/skills/**/candidates.json
.claude/skills/**/parsed.json

# ===========================================
# 환경 변수
# ===========================================
.env
envs/.env
envs/.env.*
!envs/.env.example

# ===========================================
# 테라포밍 산출물 (스켈레톤 템플릿만 추적)
#   manifest.yaml = 테라포밍이 채운 실값. 추적은 manifest.template.yaml.
#   규칙 근거: docs/plan/plan_2026062205_1 §4·§6
# ===========================================
manifest.yaml

# ===========================================
# 렌더/레시피 생성 산출물 (스켈레톤·템플릿만 추적 — 생성물은 비추적)
#   render 파이프라인이 *.template → Dockerfile·compose·requirements 산출.
#   모델별 configs(yaml=서빙인자 / sh=불편함해소)는 recipe-explorer 가 생성.
#   ⚠ 답안노출 방지: 이 산출물은 working-tree에서만 존재(클론은 빈 상태로 시작·render로 재생성).
#   규칙 근거: docs/plan/plan_2026062213_1 (단일노드 배포가능검증)
# ===========================================
# ── 멀티노드 분기(branch-specific .gitignore) ──
#   single-node는 /Dockerfile·/Dockerfile.source-build·/docker-compose.yaml 도 ignore(렌더 산출물)하지만,
#   multi-node는 손작성 Ray/NCCL/네트워크-디버그 구현이 *.template 변환의 유일 원천이라 **추적 유지**한다
#   (멀티노드 렌더 템플릿으로 졸업한 뒤 ignore 로 전환). 근거: docs/plan/plan_2026062307_1 §1 레이어2/3b.
/requirements.txt
# S1 resolve 산출 스냅샷 (버전 bump마다 재생성 — 추적 안 함)
/resolved.json
# ⚠ 폐지된 거처의 **레거시 방어**(2026-09-06 · plan_26090616). recipe 탐색 입력·잠금의 정본 자리는
#   이제 `campaigns/<camp-id>/cells/<cell-id>/` 다(등록부 tombstone). 아래 두 행은 옛 경로로 쓰는
#   실행자·서브 오버레이가 남아도 추적되지 않게 하는 그물이며, **접두어-exact 를 쓰지 않는다** —
#   exact 였기 때문에 `config.campaign-*`·`config.camp1-*` 변형이 세 번째로 빠져나가 21개가 공개
#   원격까지 누출됐다(2026-09-06 감사). 접두어 glob 은 그 변형 전체를 덮는다.
/config*.yaml
/lockset*.json
# tiktoken 에어갭 자산(gpt-oss harmony o200k — URL 다운로드본, 호스트 자산·배포물 아님)
/tiktoken_cache/
# 모델별 산출물 (범용 툴 configs/check_reqs.py 는 .py 라 미매칭 → 추적 유지)
configs/*.yaml
configs/*.sh
# 멀티노드 토폴로지 인프라(generic Ray 런너·init — 모델별 산출물 아님 → 재포함해 추적 유지)
!configs/serve_runner.sh
!configs/debug-init.sh
!configs/arm_patch.sh

# ===========================================
# output/ 통로 — single/multi 산출물 경계분리 (혼재 차단)
#   통로 껍데기(.gitkeep)만 추적 / 생성물(모델 config·env·렌더 Dockerfile 등)은 비추적.
#   생성물이 켜켜이 쌓여도 통로(single|multi)가 갈려 서로 침범 못 함.
#   예외: multi-node 손작성 컨테이너 정의는 *.template 졸업 전까지 정본 → 추적 유지(Plan 2서 ignore 강등).
#   규칙 근거: docs/plan/plan_2026062312_1
# ===========================================
output/*/*
!output/*/.gitkeep
!output/multi/Dockerfile
!output/multi/Dockerfile.source-build
!output/multi/Dockerfile.source-build-upstage
!output/multi/docker-compose.yaml
!output/multi/requirements.txt
# single 통로도 multi 와 동형 추적(2026-08-11 결함수정 — sync_to_sub.sh 의 canonical-source 준비가
#   git 인덱스 권위(checkout-index)로 output/<t>/ 빌드킷을 스냅샷하는데, single 쪽만 이 예외가 없어
#   빌드킷이 "정본에 없음"으로 오판되고 서브의 정상 빌드킷을 삭제하려 드는 브랜치가드 오탐이 발생했다
#   (testlog_26081112 계열). BAND2_TOP(sync_to_sub.sh) 과 정합.
!output/single/Dockerfile
!output/single/Dockerfile.source-build
!output/single/Dockerfile.source-build-upstage
!output/single/docker-compose.yaml
!output/single/requirements.txt
# ⛔ 철회(2026-09-10 · 사용자 결정): build_patches/ 를 "컨테이너 정의와 동급" 으로 추적 승격했던
#   예외를 걷는다. 근거 — 이 파일들은 3+1+1 의 **빌드 패치 슬롯 산출물**이고, 산출물 통로
#   (output/<t>/) 의 기본 정책은 **추적금지**다(CLAUDE.md: 빌딩블럭=추적 · 생성물=비추적 ·
#   "배포 단위 = 스켈레톤 + 생성엔진(완성품 아님)"). 손작성이라는 사실은 *정본성* 을 말할 뿐
#   *배포 대상* 임을 말하지 않는다 — 그 둘을 뭉갠 것이 이 예외였다.
#   실측 비대칭이 그 이탈을 드러냈다: single 은 `.gitkeep` 만, multi 는 9파일이 원격에 실려 있었다.
#   대신 = 슬롯 산출물은 hint 페이로드(재현 키트)와 sync_to_sub 배달이 나른다.
# 소스 이식 패치(build_patches_src/<NN>-*.sh + files/ + PROVENANCE.json) — **컴파일 前** 위상.
#   `_C` 재컴파일이 필요한 csrc 의 유일한 자리이며 포크 사다리 3번째 칸(자체 이식)의 산출물이다.
#   2026-08-13 신설: 이 예외가 없어 비추적 → sync_to_sub 의 index-권위 스냅샷에 부재 → 서브 배달
#   경로가 아예 없었다. 게다가 assert_band_classification 은 그 스냅샷을 돌기 때문에 "미분류
#   fail-loud" 조차 발화하지 못했다(누락이 침묵으로 덮임). BAND2_PATCH_DIRS(sync_to_sub.sh) 와 정합.
#   ⚠ 범위는 **손작성분만**이다(2026-08-13 축소). 초판은 `/**` 로 전부 열었는데 그러면
#   `files/` 아래 업스트림 vLLM 소스 벤더링(92파일·61,846줄)까지 추적물이 된다 — 그것은 손작성
#   정본이 아니라 **파생 산출물**이므로 CLAUDE.md 의 추적 규정(빌딩블럭=추적 · 생성물=비추적)에
#   어긋나고, "배포 단위 = 스켈레톤 + 생성엔진(완성품 아님)" 과도 부딪힌다.
#   payload 는 PROVENANCE.json 의 유도식(merge-base diff → 3-way → 선별 병합)으로 재생성하고
#   파일별 sha256 으로 검증한다. 변종 재현의 정본 경로는 이제 arch_variant_ledger 의 포크 좌표다.
# ⛔ 철회(2026-09-10 · 사용자 결정): 위와 같은 근거. build_patches_src/ 의 손작성 `*.sh` ·
#   PROVENANCE.json 도 **컴파일 前 위상의 슬롯 산출물**이지 스켈레톤이 아니다.
#   2026-08-13 이 예외를 연 사유(서브 배달 경로 부재)는 그 뒤 `regen_build_patches_src.py` 라는
#   생성엔진이 생겨 해소됐다 — 배달은 추적 승격이 아니라 그 도구와 sync_to_sub 가 한다.
#   ★ payload 명시 제외가 **반드시** 필요하다: `output/*/*` 의 `*` 는 `/` 를 넘지 않으므로
#   `output/<t>/build_patches_src/files` (4단계)는 그 패턴에 걸리지 않는다. 위 `!` 로 디렉토리를
#   재포함한 순간 git 이 안으로 내려가고, files/ 는 **어떤 규칙에도 안 걸려 기본 추적**이 된다.
#   (2026-08-13 실제 발생: 좁힌 allowlist 만으로는 92파일이 그대로 스테이징에 남았다.)
# ── 슬롯 폴더 **뼈대**는 남긴다 (2026-09-10 사용자 결정) ──────────────────────────
#   철회한 것은 *산출물 추적*이지 *폴더의 존재 선언*이 아니다. 둘은 다르다:
#     · 산출물(`<NN>-*.sh` · PROVENANCE.json · files/) = 비추적 — 위 철회 그대로.
#     · 폴더 뼈대(`.gitkeep`)                          = 추적 — 어떤 폴더가 정본인지 **선언**한다.
#   왜 필요한가: git 은 **빈 디렉터리를 들지 않는다**. 그래서 산출물을 인덱스에서 빼는 순간
#   배포 클론에서 디렉터리 자체가 사라졌고, `Dockerfile.source-build` 의
#   `COPY build_patches/ /tmp/build_patches/` 가 컨텍스트 부재로 죽었다(2026-09-10 실측 · 0693af1
#   회귀 · 로컬 워킹트리엔 파일이 남아 있어 이 노드에서는 보이지 않았다).
#   부수 이득: 정본에 없는 폴더가 슬그머니 생기는 것도 뼈대 선언이 원천 차단한다.
#
#   ⚠ 위 `!output/*/.gitkeep` 은 **한 단계만** 덮는다 — `output/<t>/build_patches/.gitkeep` 은
#   두 단계라 `output/*/*` 에 그대로 걸린다. 2026-09-10 실측: single 의 2건은 규칙이 아니라
#   **인덱스 관성**으로만 살아 있었고(지우면 다시 add 도 안 된다) multi 엔 아예 없었다 —
#   "뼈대만 추적" 이라는 위 주석의 선언에 **집행이 없었다**. 그래서 3단이 필요하다:
#     ① 디렉터리 재포함 — 없으면 git 이 그 안으로 내려가지도 않아 ③ 이 도달 불가가 된다
#     ② 내용 전량 재제외 — 산출물은 계속 비추적(`files/` 4단계 경로까지 여기서 덮인다)
#     ③ `.gitkeep` 만 재포함
!output/*/build_patches/
!output/*/build_patches_src/
output/*/build_patches/*
output/*/build_patches_src/*
!output/*/build_patches/.gitkeep
!output/*/build_patches_src/.gitkeep
output/*/build_patches_src/files/

# ===========================================
# campaigns/ — 캠페인 아티팩트 체인 (plan_26090616 · policy:ROOT_SURFACE_REGISTRY)
#   뼈대(_template/ · README.md)만 추적하고 인스턴스 campaigns/<camp-id>/ 는 휘발이다.
#   인스턴스는 셀 config 의 NAS 절대경로·세션 id·측정 원시값을 담아 배포 평면에 실릴 수 없고,
#   매 캠페인 재생성되므로 이력으로 남길 가치가 git 이 드는 비용을 넘지 않는다.
#   `/campaigns/*` 의 `*` 는 `/` 를 넘지 않으므로 디렉터리 재포함만으로 뼈대 내부가 살아난다
#   (docs/report·build_patches_src 선례와 동형).
# ===========================================
/campaigns/*
!/campaigns/_template/
